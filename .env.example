# Copy this file to .env and fill in the required values.
# Never commit .env: it contains real credentials.

# ---- Required ----
DB_HOST=YOUR_HOST
DB_USER=YOUR_USER
DB_PASSWORD=YOUR_PASSWORD
# IBM i library (schema), 1-10 characters: letters, digits, _ # @ $
DB_LIBRARY=YOURLIB

# ---- Optional (defaults shown) ----
# Name must match a driver registered in ODBC (Windows: 64-bit ODBC Administrator, Linux: odbcinst.ini)
DB_DRIVER="IBM i Access ODBC Driver"
PORT=3099
NODE_ENV=production
# Comma-separated list of allowed origins. Leave empty to disable CORS.
CORS_ORIGIN=

# Row cap for endpoints without paging (1-1000) and default page size for paged endpoints
ROW_LIMIT=500
PAGE_SIZE=100

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Concurrency and timeouts (seconds)
DB_POOL_INITIAL=1
DB_POOL_MAX=3
DB_QUEUE_MAX=50
DB_LOGIN_TIMEOUT=10
DB_QUERY_TIMEOUT=15

# ---- New in this project (optional, defaults keep the old behavior) ----
# pool        : reuse connections (same as the old project)
# per-request : open and close a connection for every query, so the lock held by
#               the QZDASOINIT job is released as soon as the request finishes.
#               DB_POOL_INITIAL is ignored in this mode; DB_POOL_MAX still caps concurrency.
DB_CONNECTION_MODE=pool
# Seconds to keep a response in memory so repeated requests (for example F5)
# do not query IBM i again. 0 disables the cache (0-3600).
CACHE_TTL_SECONDS=0
